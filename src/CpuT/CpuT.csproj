<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CpuT.Core\CpuT.Core.csproj" PrivateAssets="All" />
    <ProjectReference Include="..\CpuT.Windows\CpuT.Windows.csproj" PrivateAssets="All" />
    <ProjectReference Include="..\CpuT.Linux\CpuT.Linux.csproj" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="..\CpuT.Core\bin\$(Configuration)\net10.0\CpuT.Core.dll" Pack="true" PackagePath="lib\net10.0\" />
    <None Include="..\CpuT.Core\bin\$(Configuration)\net10.0\CpuT.Core.xml" Pack="true" PackagePath="lib\net10.0\" />
    <None Include="..\CpuT.Windows\bin\$(Configuration)\net10.0\CpuT.Windows.dll" Pack="true" PackagePath="lib\net10.0\" />
    <None Include="..\CpuT.Windows\bin\$(Configuration)\net10.0\CpuT.Windows.xml" Pack="true" PackagePath="lib\net10.0\" />
    <None Include="..\CpuT.Linux\bin\$(Configuration)\net10.0\CpuT.Linux.dll" Pack="true" PackagePath="lib\net10.0\" />
    <None Include="..\CpuT.Linux\bin\$(Configuration)\net10.0\CpuT.Linux.xml" Pack="true" PackagePath="lib\net10.0\" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <Target Name="EnsureReferencedProjectsBuilt" BeforeTargets="Pack">
    <MSBuild
      Projects="..\CpuT.Core\CpuT.Core.csproj;..\CpuT.Windows\CpuT.Windows.csproj;..\CpuT.Linux\CpuT.Linux.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration)" />
  </Target>

</Project>